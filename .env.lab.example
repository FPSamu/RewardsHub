# ─────────────────────────────────────────────────────────────────────────────
# .env del LAB de AWS Academy (rama sistemas-escalables). Sin valores reales.
#
#   cp .env.lab.example .env.lab && chmod 600 .env.lab
#   # en infra/aws/terraform.tfvars:  env_file = "../../.env.lab"
#
# Terraform sube este archivo cifrado a un bucket privado del lab y las
# instancias lo descargan. Nunca va dentro del zip del código ni a git.
#
# NO pongas aquí las variables propias de AWS: SQS_QUEUE_URL, REDIS_URL, DDB_*,
# DB_NAME, MONGO_MAX_POOL_SIZE, RATE_LIMITS, METRICS_ENABLED, GEO_QUERY_MODE,
# STATS_SOURCE, TZ, PORT, TRUST_PROXY, ALLOWED_ORIGINS, FRONTEND_URL.
# Las pone Terraform en /etc/rewardshub.env según terraform.tfvars (y ganan).
#
# Valores con espacios o "#": entre comillas (el runbook carga este archivo en
# la terminal con `set -a; . ./.env.lab; set +a`).
# ─────────────────────────────────────────────────────────────────────────────

# ═════════════════════ OBLIGATORIAS ══════════════════════════════════════════

# Tu propio cluster de MongoDB Atlas (no el del proyecto real).
# La base del URI da igual: en las instancias DB_NAME=rewardshub_lab la reemplaza.
# Atlas → Network Access debe permitir 0.0.0.0/0 mientras dure la práctica.
MONGO_URI=mongodb+srv://<usuario>:<contraseña>@<tu-cluster>.mongodb.net/?retryWrites=true&w=majority

# Secretos de los tokens: genera unos NUEVOS con `npm run generate-secrets`.
# (Sin ellos la app usa "secret": funciona, pero cualquiera podría firmar tokens.)
JWT_SECRET=<generar>
JWT_REFRESH_SECRET=<generar>

# production: CORS solo acepta la URL del frontend del lab (la pone Terraform).
# Con enable_frontend = false el navegador no podrá llamar a la API; curl y los scripts sí.
NODE_ENV=production

# ═════════════════════ OPCIONALES ════════════════════════════════════════════
# Cada bloque dice qué deja de funcionar si lo dejas vacío. La API y el worker
# arrancan igual (tests/startup.withoutOptionalServices.test.ts).

# ── Stripe (modo prueba) ─────────────────────────────────────────────────────
# Sin STRIPE_SECRET_KEY: POST /subscription/checkout, /billing-portal, /plan y
# /cancel responden error; el webhook responde 400. Todo lo demás funciona
# (los negocios del seed ya están activos). Los webhooks no llegan al lab (HTTP).
# STRIPE_SECRET_KEY=sk_test_<...>
# STRIPE_WEBHOOK_SECRET=whsec_<...>
# STRIPE_MONTHLY_PRICE_ID=price_<...>
# STRIPE_YEARLY_PRICE_ID=price_<...>
# STRIPE_LIFETIME_PRICE_ID=price_<...>
# LIFETIME_ACCESS_CODE=<código para /subscription/activate-lifetime; default "LIFETIME2025">

# ── Firebase ─────────────────────────────────────────────────────────────────
# Sin FIREBASE_*: /auth/login y /auth/register (con idToken: login normal de web
# y apps, cuentas de clientes, Google) responden 401; no hay notificaciones push.
# SÍ funciona: /auth/cashier-login (negocios con email + contraseña de sucursal;
# también desde el frontend), que es lo que usan el seed y los scripts.
# FIREBASE_PROJECT_ID=<proyecto>
# FIREBASE_CLIENT_EMAIL=<firebase-adminsdk-...@<proyecto>.iam.gserviceaccount.com>
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n<...>\n-----END PRIVATE KEY-----\n"

# ── Correo (Nodemailer) ──────────────────────────────────────────────────────
# Sin EMAIL_USER / EMAIL_PASSWORD: no se mandan correos. Verificación de cuenta
# y "olvidé mi contraseña" (si la cuenta existe) → 500 "Failed to send email";
# reset/generación del PIN de administrador → 503 (el PIN anterior sigue valiendo);
# los avisos y engagement del worker terminan con sent: 0.
# El seed del lab ya da a cada negocio el PIN de administrador 123456.
# EMAIL_SERVICE=gmail           # gmail | outlook | smtp
# EMAIL_USER=<cuenta>
# EMAIL_PASSWORD=<app password>
# EMAIL_FROM=<remitente>
# SMTP_HOST=<host>              # solo con EMAIL_SERVICE=smtp
# SMTP_PORT=587
# SMTP_SECURE=false

# ── Subida de imágenes (S3, otra cuenta) ─────────────────────────────────────
# Sin estas llaves: subir logo del negocio y foto de perfil → 500. Nada más.
# OJO: NO son las credenciales del Learner Lab. SQS, DynamoDB y CloudWatch usan
# el rol de la instancia (LabInstanceProfile) y nunca leen estas variables.
# AWS_ACCESS_KEY_ID=<...>
# AWS_SECRET_ACCESS_KEY=<...>
# AWS_REGION=us-east-1

# ── Soporte ──────────────────────────────────────────────────────────────────
# Sin ADMIN_SECRET: POST /business/admin-pin/generate responde 403 (además
# necesita correo para mandar el PIN).
# ADMIN_SECRET=<generar>

# ── Pases de Apple / Google Wallet ───────────────────────────────────────────
# Sin ellas: los endpoints de /passes responden error. No los usa ninguna demo.
# APPLE_PASS_TYPE_ID=  APPLE_TEAM_ID=  APPLE_CERTS_DIR=  APPLE_CERT_PASSWORD=
# GOOGLE_ISSUER_ID=  GOOGLE_CLASS_ID=  GOOGLE_SERVICE_ACCOUNT_JSON=

# ── Anna (invitaciones por correo, /anna/api) ────────────────────────────────
# Sin ellas: las invitaciones de Anna no se envían.
# ANNA_SMTP_HOST=  ANNA_SMTP_PORT=587  ANNA_SMTP_USER=  ANNA_SMTP_PASS=  ANNA_SMTP_FROM=

# ── Ajustes con valor por defecto (no hace falta tocarlos) ───────────────────
# JWT_EXPIRES_IN=15m
# JWT_REFRESH_EXPIRES_IN=7d
# REFRESH_GRACE_SECONDS=30
# USER_COLLECTION=  BUSINESSES_COLLECTION=  …   # nombres de colección; vacío = los de los modelos
# APP_MIN_VERSION_*=0.0.0                       # version gate de las apps móviles; 0.0.0 = sin bloqueo
