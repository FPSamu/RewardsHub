# Server Configuration
PORT=3000
NODE_ENV=production

# MongoDB Configuration
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/rewardshub?retryWrites=true&w=majority
TEST_MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/rewardshub?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Segundos que un refresh token ya rotado se sigue aceptando. Evita que dos
# pestañas que refrescan a la vez se cierren la sesión mutuamente. 0 lo desactiva.
REFRESH_GRACE_SECONDS=30

# CORS Configuration (comma-separated list of allowed origins)
# Example for Vercel deployment:
ALLOWED_ORIGINS=https://rewards-hub-opal.vercel.app,https://www.rewards-hub-opal.vercel.app

# Email Configuration (Nodemailer)
# Option 1: Gmail (recommended for development)
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=your-email@gmail.com

# Option 2: Outlook/Hotmail
# EMAIL_SERVICE=outlook
# EMAIL_USER=your-email@outlook.com
# EMAIL_PASSWORD=your-password
# EMAIL_FROM=your-email@outlook.com

# Option 3: Custom SMTP Server
# EMAIL_SERVICE=smtp
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# EMAIL_USER=your-email@example.com
# EMAIL_PASSWORD=your-password
# EMAIL_FROM=your-email@example.com

# Frontend URL (for email verification links)
FRONTEND_URL=https://rewards-hub-opal.vercel.app

# MongoDB Collection Names (optional - uses defaults if not set)
USER_COLLECTION=users
BUSINESSES_COLLECTION=businesses
SYSTEMS_COLLECTION=systems
REWARDS_COLLECTION=rewards
USERS_POINTS_COLLECTION=userPoints
TRANSACTIONS_COLLECTION=transactions
WORK_SHIFTS_COLLECTION=workShifts
SUBSCRIPTIONS_COLLECTION=subscriptions

# ── Version gate de las apps móviles ─────────────────────────────────────────
# La config se separa por APP y por PLATAFORMA, porque ambas apps comparten
# este backend y se publican por separado. Todo default 0.0.0 = gate apagado.
#
# Sube APP_MIN_VERSION_* solo cuando la versión nueva YA esté descargable en la
# tienda: por debajo de ese número la app se bloquea por completo.

# App de negocios
APP_MIN_VERSION_BUSINESS_IOS=0.0.0
APP_LATEST_VERSION_BUSINESS_IOS=1.1.0
APP_STORE_URL_BUSINESS_IOS=https://apps.apple.com/app/idXXXXXXXXX
APP_MIN_VERSION_BUSINESS_ANDROID=0.0.0
APP_LATEST_VERSION_BUSINESS_ANDROID=1.1.0
APP_STORE_URL_BUSINESS_ANDROID=https://play.google.com/store/apps/details?id=com.rewardshub.business
APP_UPDATE_MESSAGE_BUSINESS=

# App de clientes
APP_MIN_VERSION_CLIENT_IOS=0.0.0
APP_LATEST_VERSION_CLIENT_IOS=1.1.0
APP_STORE_URL_CLIENT_IOS=https://apps.apple.com/app/idYYYYYYYYY
APP_MIN_VERSION_CLIENT_ANDROID=0.0.0
APP_LATEST_VERSION_CLIENT_ANDROID=1.1.0
APP_STORE_URL_CLIENT_ANDROID=https://play.google.com/store/apps/details?id=com.rewardshub.mobile
APP_UPDATE_MESSAGE_CLIENT=

# Compatibilidad: los nombres sin ámbito (APP_LATEST_VERSION_IOS, etc.) siguen
# funcionando y aplican SOLO a la app de negocios, que es la que ya los usa.
