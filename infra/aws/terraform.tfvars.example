# Copia a terraform.tfvars y ajusta. terraform.tfvars no se versiona.
# Todos los valores de abajo son los defaults: descomenta solo lo que cambies.
# Paso a paso de una sesión del lab: docs/LAB-RUNBOOK.md

# ── Cuenta y región ─────────────────────────────────────────────────────────
# aws_profile = "academy"           # perfil de ~/.aws/credentials con las credenciales del lab
# region      = "us-east-1"         # el Learner Lab solo permite us-east-1 / us-west-2
# project     = "rewardshub"        # prefijo de todos los recursos

# ── App ─────────────────────────────────────────────────────────────────────
# env_file      = "../../.env"      # .env que se sube al bucket privado; usa uno propio del lab, p. ej. "../../.env.lab"
# node_version  = "22.12.0"
# instance_type = "t3.small"        # API y workers (t3.micro se queda sin memoria al compilar)
# instance_profile_name = "LabInstanceProfile"  # el lab no deja crear roles
# key_name      = null              # "vockey" = SSH con la llave del lab

# ── Base de datos (P0) ──────────────────────────────────────────────────────
# MongoDB 7 en una EC2 dentro de la VPC (mongo.tf); el lab nunca usa Atlas.
# lab_db_name               = "rewardshub_lab"  # DB_NAME del lab; el usuario de la app solo escribe aquí
# mongo_max_pool_size       = 20                # conexiones a Mongo por proceso (MONGO_MAX_POOL_SIZE)
# enable_mongo              = true              # false = sin base (solo para probar la infraestructura)
# mongo_instance_type       = "t3.medium"
# mongo_image               = "mongo:7.0"       # versión fija, nunca latest
# mongo_volume_gb           = 20                # gp3 en /data/db; se borra con ./lab.sh down
# mongo_wiredtiger_cache_gb = 1.5
# mongo_connect_retries     = 20                # MONGO_CONNECT_RETRIES: la API espera a Mongo al arrancar

# ── Escalado ────────────────────────────────────────────────────────────────
# api_min        = 2
# api_desired    = 2
# api_max        = 4
# api_cpu_target = 40                # % de CPU promedio que mantiene el ASG de la API (Node usa 1 de 2 vCPU: saturada marca ~55 %)
# worker_min     = 1
# worker_max     = 3
# backlog_age_seconds = 120          # jobs-backlog agrega un worker si un trabajo espera más que esto (2 min seguidos)

# ── Cola y trabajos programados (EventBridge, cron en UTC; "" apaga la regla) ─
# sqs_visibility_seconds = 900
# sqs_max_receive_count  = 5         # intentos antes de la DLQ
# notification_schedule  = "cron(0 10 * * ? *)"
# engagement_schedule    = "cron(0 19 * * ? *)"
# daily_stats_schedule   = "cron(15 6 * * ? *)"   # recalcula los últimos 2 días UTC en daily_stats
# reconcile_schedule     = "cron(30 7 * * ? *)"   # conciliación de saldos (solo reporta)
# replicate_schedule     = "rate(10 minutes)"     # réplica a DynamoDB (solo con enable_dynamo)

# ── WAF ─────────────────────────────────────────────────────────────────────
# enable_waf     = true              # rate limit por IP en el ALB; false si el lab no permite WAF
# waf_rate_limit = 1000              # peticiones por IP en 5 minutos

# ── Frontend (sitio estático de S3) ─────────────────────────────────────────
# enable_frontend = true
# frontend_dir    = "../../../rewardshub_front"   # p. ej. "/home/luis/rew_hub/rew_hub_front/RewardsHubFront"; si no existe, el frontend se omite

# ── Banderas de la app (P2) ─────────────────────────────────────────────────
# geo_query_mode = "legacy"          # "geo" = mapa con índice 2dsphere
# stats_source   = "dynamo"          # réplica en DynamoDB (requiere enable_dynamo); "daily" = daily_stats en Mongo; "live" = agregación completa

# ── Redis (P4) — probado en el lab (README → Limitaciones) ───────────────────
# redis_mode           = "elasticache"  # "ec2" (plan B: Valkey en EC2) | "off"
# redis_node_type      = "cache.t3.micro"  # modo elasticache
# redis_engine_version = "7.1"             # modo elasticache (parameter group default.redis7)
# redis_instance_type  = "t3.micro"        # modo ec2
# enable_rate_limits   = true        # RATE_LIMITS=on: por instancia sin Redis, globales con Redis
# cache_bizmap_ttl     = 120         # segundos de caché del mapa

# ── DynamoDB (P5) — probado en el lab (README → Limitaciones) ────────────────
# enable_dynamo = true               # tablas daily-stats y transactions + job replicate-dynamo; false = todo de Mongo

# ── Observabilidad (P6) ─────────────────────────────────────────────────────
# enable_grafana           = true    # Grafana OSS sobre CloudWatch (./lab.sh grafana da la URL)
# admin_cidr               = null    # tu IP pública /32; si no la pones, ./lab.sh up usa la actual (checkip.amazonaws.com)
# grafana_instance_type    = "t3.micro"
# grafana_anonymous_viewer = false   # true: ver dashboards sin login (sigue limitado a admin_cidr)
# enable_app_metrics       = true    # METRICS_ENABLED=true: métricas propias de la app en CloudWatch (paneles "App")
