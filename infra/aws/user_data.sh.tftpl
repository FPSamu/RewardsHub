#!/bin/bash
# Arranque de una instancia RewardsHub (rol: ${role}).
# Logs de este script: /var/log/cloud-init-output.log
# Logs de la app:      journalctl -u rewardshub -f
set -euxo pipefail
export PATH=/usr/local/bin:$PATH

dnf install -y tar xz unzip

# Node.js (binario oficial, misma versión en todas las instancias)
curl -fsSL "https://nodejs.org/dist/v${node_version}/node-v${node_version}-linux-x64.tar.xz" \
  | tar -xJ -C /usr/local --strip-components=1

id rewardshub >/dev/null 2>&1 || useradd --system --create-home --shell /sbin/nologin rewardshub
rm -rf /opt/rewardshub && mkdir -p /opt/rewardshub

# Código y .env desde el bucket privado (credenciales: LabInstanceProfile)
aws s3 cp "s3://${bucket}/${app_key}" /tmp/app.zip --region ${region}
unzip -q /tmp/app.zip -d /opt/rewardshub
aws s3 cp "s3://${bucket}/${env_key}" /opt/rewardshub/.env --region ${region}
chmod 600 /opt/rewardshub/.env

cd /opt/rewardshub
export HOME=/root
# Si el lockfile no cuadra con esta versión de npm, no tumbar el arranque.
npm ci --omit=dev --no-audit --no-fund || npm install --omit=dev --no-audit --no-fund
npm run build
chown -R rewardshub:rewardshub /opt/rewardshub

# Variables propias de AWS. systemd las pone en el entorno y dotenv no
# sobreescribe variables existentes, así que ganan sobre el .env.
cat > /etc/rewardshub.env <<ENV
PORT=3000
# Días de las estadísticas = días UTC (daily_stats). Render ya corre en UTC.
TZ=UTC
TRUST_PROXY=1
SQS_QUEUE_URL=${queue_url}
SQS_REGION=${region}
SQS_VISIBILITY_SECONDS=${visibility_seconds}
%{ if mongo_uri != "" ~}
# MongoDB del lab (mongo.tf, dentro de la VPC). Gana sobre el .env, que no debe traer MONGO_URI.
MONGO_URI=${mongo_uri}
MONGO_CONNECT_RETRIES=${mongo_retries}
%{ endif ~}
%{ if db_name != "" ~}
# Base propia del lab: mongoose.connect({ dbName }) ignora la base del MONGO_URI
DB_NAME=${db_name}
%{ endif ~}
MONGO_MAX_POOL_SIZE=${mongo_pool_size}
%{ if geo_query_mode != "legacy" ~}
GEO_QUERY_MODE=${geo_query_mode}
%{ endif ~}
%{ if stats_source != "live" ~}
STATS_SOURCE=${stats_source}
%{ endif ~}
%{ if redis_url != "" ~}
# Redis (redis_mode): caché del mapa + rate limits compartidos. Si no responde, la API sigue (falla abierta).
REDIS_URL=${redis_url}
CACHE_BIZMAP_TTL=${cache_bizmap_ttl}
%{ endif ~}
%{ if rate_limits ~}
RATE_LIMITS=on
%{ endif ~}
%{ if ddb_daily_stats != "" ~}
# Réplica en DynamoDB (enable_dynamo): la llena replicate-dynamo; la leen las
# estadísticas y los reportes con STATS_SOURCE=dynamo (con respaldo en Mongo).
DDB_DAILY_STATS_TABLE=${ddb_daily_stats}
DDB_TRANSACTIONS_TABLE=${ddb_transactions}
DDB_REGION=${region}
%{ endif ~}
%{ if app_metrics ~}
# Métricas propias en CloudWatch (namespace RewardsHub) con el rol de la instancia
METRICS_ENABLED=true
%{ endif ~}
%{ if frontend_url != "" ~}
ALLOWED_ORIGINS=${frontend_url}
FRONTEND_URL=${frontend_url}
%{ endif ~}
ENV
# Lleva la contraseña de Mongo: solo root (systemd lee EnvironmentFile como root)
chmod 600 /etc/rewardshub.env

# rh-cli <script> [args]: scripts de mantenimiento (dist/cli/run.js) con el
# mismo entorno y usuario que el servicio. Lo usan ./lab.sh seed y ./lab.sh run.
cat > /usr/local/bin/rh-cli <<'SH'
#!/bin/bash
exec systemd-run --quiet --uid=rewardshub --gid=rewardshub --working-directory=/opt/rewardshub \
  -p EnvironmentFile=/etc/rewardshub.env --wait --pipe --collect \
  /usr/local/bin/node dist/cli/run.js "$@"
SH
chmod 755 /usr/local/bin/rh-cli

cat > /etc/systemd/system/rewardshub.service <<UNIT
[Unit]
Description=RewardsHub ${role}
After=network-online.target
Wants=network-online.target

[Service]
User=rewardshub
WorkingDirectory=/opt/rewardshub
EnvironmentFile=/etc/rewardshub.env
ExecStart=/usr/local/bin/node dist/${entrypoint}.js
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=${stop_timeout}

[Install]
WantedBy=multi-user.target
UNIT

systemctl daemon-reload
systemctl enable --now rewardshub
